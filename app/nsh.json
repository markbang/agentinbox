{
  "name": "AgentInbox",
  "id": "top.bangwu.nshmail",
  "version": "0.0.6",
  "build": 9,
  "rust": [
    "../vendor/nsh-cupertino",
    "."
  ],
  "theme": "theme.json",
  "icon": "icon.png",
  "schemes": [
    "nshmail"
  ],
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "webview": {
      "hosts": []
    },
    "statusBar": true,
    "clipboard": true,
    "picker": true,
    "notifications": true,
    "openUrl": true,
    "windows": true
  },
  "tailwind": {
    "radius": {
      "row": 10,
      "sheet": 14,
      "button": 12,
      "search": 9
    },
    "fontSize": {
      "largeTitle": [
        34,
        1.206
      ],
      "title1": [
        28,
        1.214
      ],
      "title2": [
        22,
        1.273
      ],
      "title3": [
        20,
        1.25
      ],
      "headline": [
        17,
        1.294
      ],
      "body": [
        17,
        1.294
      ],
      "callout": [
        16,
        1.312
      ],
      "subheadline": [
        15,
        1.333
      ],
      "footnote": [
        13,
        1.385
      ],
      "caption1": [
        12,
        1.333
      ],
      "caption2": [
        11,
        1.182
      ]
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "window": {
    "title": "AgentInbox",
    "defaultSize": {
      "width": 1180,
      "height": 760
    },
    "minSize": {
      "width": 380,
      "height": 520
    },
    "closeOnPress": false
  },
  "appearance": "system"
}
